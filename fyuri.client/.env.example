# Frontend build configuration
#
# Copy to `.env.production` (or `.env.local`) inside fyuri.client/ before running
# `npm run build`. Vite inlines these values at BUILD time, not runtime.

# Leave EMPTY if the API is served from the same domain via a reverse proxy
# (recommended). Example: https://fyuri.co.il serves both the site and /api.
VITE_API_BASE_URL=

# Set this ONLY if the .NET backend lives on a different origin, e.g.:
# VITE_API_BASE_URL=https://api.fyuri.co.il
# Note: the backend must then allow that origin in CORS (AllowedOrigins).

# Sub-path where the app is hosted. Vite `base` + React Router `basename` use
# this so the app can live under e.g. munkys.dev/fyuri. Must start and end with
# a slash. Defaults to "/fyuri/" when unset. Set to "/" to host at the root.
# The value must match the backend PathBase and the Caddy /fyuri route.
VITE_BASE_PATH=/fyuri/
