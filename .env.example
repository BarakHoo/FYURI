# Copy to .env and fill in real values. NEVER commit .env to source control.

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Initial admin bootstrap / explicit reset only.
# Required when no admin exists or while running `reset-admin`.
# Use a real email and a unique password of at least 12 characters; 16+ is recommended.
# Clear both values after provisioning or reset.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT (required on every startup; generate 64+ random chars, e.g. `openssl rand -base64 48`)
# Keep this stable. Changing it invalidates every active admin session.
JWT_SECRET=

# Email / SMTP
EMAIL_ADMIN=your-admin@example.com
EMAIL_SENDER=
EMAIL_SENDER_NAME=FYURI
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
