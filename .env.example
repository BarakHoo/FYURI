# Copy to .env and fill in real values. NEVER commit .env to source control.

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Admin account
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=

# JWT (generate 64+ random chars, e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Email / SMTP
# Recommended: Brevo (free 300 emails/day) - see EMAIL_SETUP.md for step-by-step.
# EMAIL_ADMIN  = where the owner receives new-order / contact notifications
# EMAIL_SENDER = the verified "from" address on your domain, e.g. no-reply@fyuri.co.il
EMAIL_ADMIN=your-admin@example.com
EMAIL_SENDER=
EMAIL_SENDER_NAME=FYURI
EMAIL_SMTP_SERVER=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SSL_MODE=StartTls
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
