# FYURI - Caddy reverse proxy with automatic HTTPS
#
# Point an A/AAAA DNS record for munkys.dev (and www.munkys.dev) at this
# server's public IP. Caddy will automatically obtain and renew a
# Let's Encrypt TLS certificate for these domains.
#
# For local testing without a domain, replace the site address with
# ":80" (HTTP only) or "localhost".

munkys.dev, www.munkys.dev {
	encode gzip zstd

	# The frontend Nginx container already serves the SPA and proxies
	# /api/ and /images/ to the backend, so forward everything to it.
	reverse_proxy frontend:80

	# Optional: send your email to Let's Encrypt for expiry notices.
	# tls you@example.com
}
