# FYURI - Caddy reverse proxy with automatic HTTPS
#
# Point an A/AAAA DNS record for munkys.dev (and www.munkys.dev) at this
# server's public IP. Caddy will automatically obtain and renew a
# Let's Encrypt TLS certificate for these domains.
#
# For local testing without a domain, replace the site address with
# ":80" (HTTP only) or "localhost".

munkys.dev, www.munkys.dev {
	encode gzip zstd

	# FYURI is hosted under the /fyuri subpath so the root domain can later
	# serve a separate portfolio site. handle_path strips the /fyuri prefix
	# before forwarding, so the existing frontend Nginx container (which serves
	# the SPA at root and proxies /api/ and /images/ to the backend) keeps
	# working unchanged. The frontend build sets Vite base + router basename to
	# /fyuri/, so all browser-side URLs carry the prefix that Caddy strips here.
	handle_path /fyuri/* {
		reverse_proxy frontend:80
	}

	# Redirect the bare /fyuri (no trailing slash) to /fyuri/ so relative asset
	# URLs resolve correctly.
	redir /fyuri /fyuri/ 308

	# --- Static side-projects (each is its own repo + Nginx container) ---
	# handle_path strips the subpath prefix, so each project's Nginx serves at
	# root. The projects use relative asset paths, so they work under any prefix.
	# Containers come from docker-compose.projects.yml.
	handle_path /calc3d/* {
		reverse_proxy calc3d:80
	}
	redir /calc3d /calc3d/ 308

	handle_path /face/* {
		reverse_proxy face:80
	}
	redir /face /face/ 308

	handle_path /gps-reminder/* {
		reverse_proxy gps-reminder:80
	}
	redir /gps-reminder /gps-reminder/ 308

	handle_path /shopping-list/* {
		reverse_proxy shopping-list:80
	}
	redir /shopping-list /shopping-list/ 308

	handle_path /face-mesh/* {
		reverse_proxy face-mesh:80
	}
	redir /face-mesh /face-mesh/ 308

	# Root and everything else: serve the static portfolio site from the folder
	# mounted into the Caddy container at /srv/portfolio (see docker-compose.yml).
	# This is the personal portfolio at munkys.dev; FYURI stays under /fyuri.
	handle {
		root * /srv/portfolio
		try_files {path} /index.html
		file_server
	}

	# Optional: send your email to Let's Encrypt for expiry notices.
	# tls you@example.com
}
